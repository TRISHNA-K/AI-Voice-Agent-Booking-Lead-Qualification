# ==============================================================================
# Voice AI Agent Configuration Template
# Duplicate this file to .env and configure your credentials.
# ==============================================================================

# Server Settings
APP_NAME="Dograh Voice AI Agent Service"
APP_ENV=development
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
WEBHOOK_BASE_URL=http://localhost:8000

# Dograh AI Platform Settings
DOGRAH_API_URL=http://localhost:8000
DOGRAH_API_KEY=dograh_live_default_key
DOGRAH_INBOUND_WORKFLOW_ID=wf_inbound_booking_001
DOGRAH_OUTBOUND_WORKFLOW_ID=wf_outbound_lead_002
DOGRAH_TELEPHONY_PROVIDER=twilio

# Cal.com API Settings (Get your key at https://app.cal.com/settings/developer/api-keys)
CALCOM_API_KEY=cal_live_mock_api_key_12345
CALCOM_API_URL=https://api.cal.com/v1
CALCOM_EVENT_TYPE_ID=123456
CALCOM_USERNAME=sales-team
CALCOM_TIMEZONE=America/New_York
CALCOM_WEBHOOK_SECRET=cal_webhook_secret_xyz

# CRM Settings (Options: mock, hubspot, salesforce, pipedrive)
CRM_PROVIDER=mock
CRM_API_KEY=your_crm_api_key_here
CRM_BASE_URL=https://api.hubapi.com
CRM_DATABASE_FILE=data/mock_crm_database.json

# LLM APIs (OpenAI / Anthropic / Gemini)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Telephony Escalation & Human Transfer
TELEPHONY_ACCOUNT_SID=AC_mock_twilio_account_sid
TELEPHONY_AUTH_TOKEN=mock_twilio_auth_token
TELEPHONY_FROM_NUMBER=+15551234567
HUMAN_ESCALATION_PHONE_NUMBER=+18005550199

# Business & Persona Details
COMPANY_NAME="NovaTech Solutions"
AGENT_NAME="Alex"
SUPPORT_EMAIL="support@novatech-solutions.example"

# BANT Qualification Thresholds (0 - 100)
BANT_MIN_QUALIFIED_SCORE=70
BANT_MIN_WARM_SCORE=40
